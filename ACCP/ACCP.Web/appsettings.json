{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS01;Database=ACCP_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Security": {
    "Tls": {
      "AllowTls12Fallback": false
    },
    "Kestrel": {
      "MaxConcurrentConnections": 2000,
      "MaxConcurrentUpgradedConnections": 1000
    },
    "ForwardedHeaders": {
      "KnownProxies": []
    },
    "KeyManagement": {
      "Provider": "Environment"
    }
  },

  "AllowedHosts": "*"
}