@page "/forgot-password"
@model ACCP.Web.Pages.Account.ForgotPasswordModel

@{
    Layout = null;

    var hasEmailError =
        ViewData.ModelState.TryGetValue("Input.Email", out var emailState)
        && emailState.Errors.Count > 0;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="referrer" content="no-referrer" />
    <title>استعادة كلمة المرور | وَثيق</title>

    <style>
        * { box-sizing: border-box; }
        :root { color-scheme: light; }
        body { margin: 0; background: #F8FAFC; color: #0F2744; font-family: "IBM Plex Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif; line-height: 1.9; }
        a { color: #0F2744; text-underline-offset: 4px; }
        input, button { font: inherit; }
        .portal-footer { margin-top: 1.25rem; color: #16335B; font-size: .72rem; text-align: center; }
        .page { max-width: 1120px; margin: auto; padding: 25px 24px 55px; }
        .topbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 55px; }
        .brand { color: #0F2744; font-size: 1.4rem; font-weight: 800; letter-spacing: normal; text-decoration: none; }
        .brand [dir="ltr"] { letter-spacing: .08em; }
        .back { color: #0F2744; font-size: .82rem; text-decoration: none; }
        .back:hover { color: #0F2744; text-decoration: underline; }
        .layout { display: grid; grid-template-columns: 1.05fr 1fr; grid-template-areas: "form intro"; border: 1px solid #E0F2FE; border-radius: 19px; overflow: hidden; background: #FFFFFF; box-shadow: 0 12px 35px #0F274405; }
        .intro { grid-area: intro; min-width: 0; padding: 48px 40px; background: #0F2744; color: #FFFFFF; }
        .eyebrow { display: inline-block; margin: 0 0 24px; padding: 5px 12px; border: 1px solid #38BDF8; border-radius: 20px; color: #E0F2FE; background: #16335B; font-size: .75rem; }
        h1 { margin: 0 0 22px; font-size: clamp(1.65rem, 3vw, 2rem); font-weight: 750; line-height: 1.7; }
        h1 span { color: #38BDF8; }
        .lead { margin: 0; color: #E0F2FE; font-size: .88rem; line-height: 2; }
        .steps { display: grid; gap: 22px; margin: 32px 0; padding: 0; list-style: none; }
        .step { display: flex; align-items: flex-start; gap: 12px; }
        .step-number { display: grid; place-items: center; flex-shrink: 0; width: 31px; height: 31px; border: 1px solid #16335B; border-radius: 8px; color: #E0F2FE; font-size: .74rem; }
        .step strong { display: block; margin-bottom: 4px; font-size: .85rem; }
        .step p { margin: 0; color: #E0F2FE; font-size: .79rem; line-height: 1.95; }
        .privacy { margin: 0; padding-top: 22px; border-top: 1px solid #16335B; color: #E0F2FE; font-size: .78rem; line-height: 2; }
        .card { grid-area: form; min-width: 0; padding: 48px 40px; align-self: center; }
        .tag { display: block; margin-bottom: 13px; color: #0F2744; font-size: .79rem; font-weight: 650; }
        h2 { margin: 0 0 15px; font-size: 1.5rem; line-height: 1.6; }
        .description { margin: 0 0 27px; color: #0F2744; font-size: .86rem; line-height: 1.95; }
        label { display: block; margin-bottom: 9px; font-size: .84rem; font-weight: 650; }
        .input { display: block; width: 100%; min-height: 49px; padding: 12px 14px; border: 1px solid #E0F2FE; border-radius: 9px; background: #FFFFFF; color: #0F2744; font-size: .9rem; text-align: left; }
        .input:focus { border-color: #0F2744; outline: 0; box-shadow: 0 0 0 3px #E0F2FE; }
        .input[aria-invalid="true"] { border-color: #0F2744; }
        .help { margin: 10px 0 23px; color: #0F2744; font-size: .76rem; line-height: 1.9; }
        .field-error { display: block; margin-top: 7px; color: #0F2744; font-size: .78rem; overflow-wrap: anywhere; }
        .field-validation-valid, .validation-summary-valid { display: none; }
        .alert { margin-bottom: 20px; padding: 14px 16px; border: 1px solid #E0F2FE; border-radius: 9px; background: #E0F2FE; color: #0F2744; font-size: .82rem; overflow-wrap: anywhere; }
        .alert ul { margin: 0; padding-inline-start: 20px; }
        .button { display: inline-flex; align-items: center; justify-content: center; min-height: 47px; padding: 11px 18px; border: 1px solid #0284C7; border-radius: 9px; background: #0F2744; color: #FFFFFF; font-size: .86rem; font-weight: 650; text-decoration: none; cursor: pointer; }
        .button:hover { background: #0F2744; border-color: #0F2744; }
        .wide { width: 100%; }
        a:focus-visible, button:focus-visible { outline: 3px solid #38BDF8; outline-offset: 4px; }
        .staff-note { margin: 24px 0 0; padding: 17px; border: 1px solid #E0F2FE; border-radius: 9px; background: #F8FAFC; color: #0F2744; font-size: .76rem; line-height: 1.95; }
        .notice { margin: 23px 0; padding: 17px; border: 1px solid #E0F2FE; border-radius: 10px; background: #E0F2FE; color: #0F2744; font-size: .82rem; line-height: 1.95; }
        .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; margin-top: 25px; }
        .retry { font-size: .8rem; }
        @@media (max-width: 800px) {
            .page { max-width: 620px; }
            .topbar { margin-bottom: 28px; }
            .layout { grid-template-columns: 1fr; grid-template-areas: "form" "intro"; }
            .card, .intro { padding: 32px; }
        }
        @@media (max-width: 480px) {
            .page { padding: 20px 14px 32px; }
            .card, .intro { padding: 27px 21px; }
            .layout { border-radius: 14px; }
            .actions { align-items: stretch; flex-direction: column; }
            .retry { text-align: center; }
        }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Readex+Pro:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/wathiq-auth.css" />
</head>

<body>
    <main class="page">
        <nav class="topbar" aria-label="التنقل">
            <a href="/" class="brand" dir="ltr">وَثيق</a>
            <a href="/login" class="back">العودة إلى تسجيل الدخول ←</a>
        </nav>

        <div class="layout">
            <aside class="intro" aria-labelledby="page-title">
                <p class="eyebrow">استعادة حساب المشتكي</p>

                <h1 id="page-title">
                    ارجع إلى حسابك.<br />
                    <span>وكمل متابعتك.</span>
                </h1>

                <p class="lead">
                    استخدم البريد الإلكتروني المرتبط بحسابك لطلب
                    رابط تعيين كلمة مرور جديدة.
                </p>

                <ol class="steps" aria-label="خطوات استعادة الحساب">
                    <li class="step">
                        <span class="step-number" aria-hidden="true">01</span>
                        <div>
                            <strong>أدخل البريد المسجّل</strong>
                            <p>استخدم البريد نفسه الذي أنشأت به حسابك.</p>
                        </div>
                    </li>

                    <li class="step">
                        <span class="step-number" aria-hidden="true">02</span>
                        <div>
                            <strong>افتح رسالة الاستعادة</strong>
                            <p>اتبع الرابط الموجود في الرسالة للمتابعة.</p>
                        </div>
                    </li>

                    <li class="step">
                        <span class="step-number" aria-hidden="true">03</span>
                        <div>
                            <strong>عيّن كلمة مرور جديدة</strong>
                            <p>احفظ التغيير ثم عد إلى تسجيل الدخول.</p>
                        </div>
                    </li>
                </ol>

                <p class="privacy">
                    احتفظ برابط الاستعادة لنفسك، ولا تشاركه في المحادثات أو البلاغات.
                </p>
            </aside>

            <section class="card" aria-labelledby="section-title">
                @if (Model.RequestCompleted)
                {
                    <span class="tag">متابعة طلب الاستعادة</span>
                    <h2 id="section-title">راجع بريدك للمتابعة</h2>

                    <p id="confirmation"
                       class="description"
                       role="status">
                        @Model.ConfirmationMessage
                    </p>

                    <div class="notice">
                        تحقّق من صندوق الوارد ومجلد الرسائل غير المرغوب فيها.
                        افتح رابط الاستعادة الموجود في الرسالة للمتابعة.
                    </div>

                    <div class="actions">
                        <a href="/login" class="button">
                            العودة إلى تسجيل الدخول
                        </a>
                        <a href="/forgot-password" class="retry">
                            إدخال البريد مجددًا
                        </a>
                    </div>
                }
                else
                {
                    <span class="tag">حسابات المشتكين</span>
                    <h2 id="section-title">نسيت كلمة المرور؟</h2>

                    <p class="description">
                        أدخل بريدك الإلكتروني لطلب رابط الاستعادة.
                    </p>

                    <div asp-validation-summary="ModelOnly"
                         class="alert"
                         role="alert"></div>

                    <form method="post"
                          asp-page="/Account/ForgotPassword"
                          asp-antiforgery="true">

                        <label for="recovery-email">
                            البريد الإلكتروني المسجّل
                        </label>

                        <input asp-for="Input.Email"
                               id="recovery-email"
                               type="email"
                               class="input"
                               dir="ltr"
                               autocomplete="email"
                               inputmode="email"
                               autocapitalize="none"
                               spellcheck="false"
                               maxlength="256"
                               required
                               aria-describedby="email-help email-error"
                               aria-invalid="@(hasEmailError ? "true" : "false")" />

                        <span asp-validation-for="Input.Email"
                              id="email-error"
                              class="field-error"
                              role="alert"></span>

                        <p id="email-help" class="help">
                            استخدم البريد الذي سجّلت به حسابك في بوابة وَثيق.
                        </p>

                        <button type="submit" class="button wide">
                            إرسال رابط الاستعادة
                        </button>
                    </form>

                    <p class="staff-note">
                        حسابات الموظفين تُدار من المسؤول.
                        إذا نسيت كلمة مرور حساب الموظف،
                        تواصل مع مسؤول المنصة.
                    </p>
                }
            </section>
        </div>
        <footer class="portal-footer">وَثيق | WATHIQ · بوابة التوثيق والمتابعة</footer>
    </main>
</body>
</html>