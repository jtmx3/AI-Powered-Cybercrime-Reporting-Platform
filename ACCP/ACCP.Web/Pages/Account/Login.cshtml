@page "/login"
@model ACCP.Web.Pages.Account.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0A192F" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>تسجيل الدخول | وَثيق | WATHIQ</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        .accp-auth { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; margin: 0; background: #F8FAFC; color: #0A192F; font-family: "IBM Plex Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif; line-height: 1.75; }
        .auth-topbar { width: min(1040px, calc(100% - 2.5rem)); margin-inline: auto; padding-block: 1.1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .auth-brand { display: inline-flex; align-items: center; gap: .65rem; color: #0F2744; text-decoration: none; }
        .auth-brand:hover { color: #0F2744; }
        .auth-brand-icon { display: block; width: 2.5rem; height: 2.85rem; flex: 0 0 auto; }
        .auth-brand-icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
        .auth-brand > span:last-child { display: flex; flex-direction: column; gap: .05rem; }
        .auth-brand strong { font-size: 1.1rem; line-height: 1.3; }
        .auth-brand small { color: #16335B; font-size: .66rem; }
        .auth-home-link { display: inline-flex; align-items: center; gap: .45rem; min-height: 2.5rem; color: #16335B; font-size: .8rem; text-decoration: none; }
        .auth-home-link:hover { color: #0F2744; text-decoration: underline; }
        .auth-main { display: grid; flex: 1 0 auto; place-items: center; padding: 1.25rem 1rem 2.5rem; }
        .auth-card { width: min(470px, 100%); padding: clamp(1.4rem, 4vw, 2.25rem); border: 1px solid #E2E8F0; border-radius: .85rem; background: #FFFFFF; }
        .auth-card h1 { margin: 0 0 .3rem; color: #0F2744; font-size: 1.65rem; line-height: 1.5; }
        .auth-description { margin: 0 0 1.35rem; color: #16335B; font-size: .86rem; }
        .auth-field { margin-bottom: .95rem; }
        .auth-form .form-label { display: block; margin-bottom: .35rem; color: #0F2744; font-size: .84rem; font-weight: 600; }
        .auth-form .form-control { display: block; width: 100%; min-height: 2.9rem; padding: .62rem .75rem; border: 1px solid #CBD5E1; border-radius: .45rem; background: #FFFFFF; color: #0A192F; font: inherit; line-height: 1.5; }
        .auth-form .form-control:focus { outline: 0; border-color: #0284C7; box-shadow: 0 0 0 .18rem #0284C71c; }
        .auth-field-error { display: block; margin-top: .25rem; color: #0F2744; font-size: .76rem; line-height: 1.7; }
        .auth-field-error.field-validation-valid, .auth-field-error:empty, .auth-validation.validation-summary-valid { display: none; }
        .auth-form .input-validation-error { border-color: #0F2744; }
        .auth-validation.validation-summary-errors { margin-bottom: 1rem; padding: .7rem .85rem; border: 1px solid #BAE6FD; border-radius: .45rem; background: #E0F2FE; color: #0A192F; font-size: .82rem; }
        .auth-validation ul { margin: 0; padding-inline-start: 1.1rem; }
        .auth-options { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; margin-block: .25rem 1rem; font-size: .78rem; }
        .auth-options .form-check { display: flex; align-items: center; gap: .45rem; margin: 0; padding: 0; }
        .auth-options .form-check-input { width: 1rem; height: 1rem; margin: 0; accent-color: #0284C7; cursor: pointer; }
        .auth-options .form-check-label { color: #16335B; cursor: pointer; }
        .auth-options a, .auth-register a { color: #0F2744; text-decoration: none; }
        .auth-options a:hover, .auth-register a:hover { text-decoration: underline; }
        .auth-submit { display: flex; width: 100%; min-height: 2.9rem; align-items: center; justify-content: center; gap: .7rem; padding: .65rem 1rem; border: 1px solid #0F2744; border-radius: .45rem; background: #0F2744; color: #FFFFFF; font: 600 .9rem/1.5 "IBM Plex Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif; cursor: pointer; }
        .auth-submit:hover { border-color: #0A192F; background: #0A192F; }
        .auth-register { margin: 1.15rem 0 0; padding-top: .9rem; border-top: 1px solid #E2E8F0; color: #16335B; font-size: .8rem; text-align: center; }
        .auth-register a { margin-inline-start: .2rem; font-weight: 600; }
        .auth-footer { width: min(1040px, calc(100% - 2.5rem)); margin: 0 auto; padding-block: .6rem 1rem; color: #16335B; font-size: .7rem; display: flex; justify-content: space-between; gap: .8rem; }
        .accp-auth :focus-visible { outline: 3px solid #0284C7; outline-offset: 3px; }
        @@media (max-width: 480px) {
            .auth-topbar { width: calc(100% - 2rem); padding-block: .85rem; }
            .auth-main { padding-inline: .75rem; }
            .auth-card { padding: 1.25rem; }
            .auth-footer { width: calc(100% - 2rem); }
        }
    </style>
    <link rel="stylesheet" href="/wathiq-brand.css" />
</head>
<body class="accp-auth">
    <header class="auth-topbar">
        <a href="/" class="auth-brand" aria-label="وَثيق | WATHIQ — الصفحة الرئيسية">
            <span class="auth-brand-icon" aria-hidden="true"><img src="/wathiq-emblem.svg" alt="" /></span>
            <span><strong>وَثيق</strong><small dir="ltr">WATHIQ · بوابة التوثيق والمتابعة</small></span>
        </a>
        <a href="/" class="auth-home-link"><span aria-hidden="true">→</span> الرئيسية</a>
    </header>

    <main class="auth-main">
        <section class="auth-card" aria-labelledby="login-title">
            <h1 id="login-title">تسجيل الدخول</h1>
            <p class="auth-description">أدخل بريدك الإلكتروني وكلمة المرور للمتابعة.</p>

            <form method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username"
                           dir="ltr" inputmode="email" autocapitalize="none" spellcheck="false"
                           aria-describedby="login-email-error" />
                    <span asp-validation-for="Input.Email" id="login-email-error" class="auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                           dir="ltr" aria-describedby="login-password-error" />
                    <span asp-validation-for="Input.Password" id="login-password-error" class="auth-field-error"></span>
                </div>

                <div class="auth-options">
                    <div class="form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">تذكرني على هذا الجهاز</label>
                    </div>
                    <a href="/forgot-password">نسيت كلمة المرور؟</a>
                </div>

                <button type="submit" class="auth-submit">تسجيل الدخول</button>
            </form>

            <p class="auth-register">ليس لديك حساب؟ <a href="/register">إنشاء حساب</a></p>
        </section>
    </main>

    <footer class="auth-footer"><span>وَثيق | WATHIQ</span><span>© @DateTime.UtcNow.Year</span></footer>
</body>
</html>
