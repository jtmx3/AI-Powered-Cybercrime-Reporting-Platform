@page "/login/two-factor"
@model ACCP.Web.Pages.Account.LoginTwoFactorModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="referrer" content="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>التحقق بخطوتين | وَثيق | WATHIQ</title>
    <style>
:root { color-scheme: light; }
* { box-sizing: border-box; }
body { margin: 0; background: #F8FAFC; color: #0F2744; font-family: "IBM Plex Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif; line-height: 1.8; }
button, input { font: inherit; }
.shell { min-height: calc(100vh - 2.5rem); min-height: calc(100dvh - 2.5rem); display: grid; place-items: center; padding: 28px 16px; }
.card { width: 100%; max-width: 460px; padding: 2rem; background: #FFFFFF; border: 1px solid #E0F2FE; border-radius: 1rem; box-shadow: 0 12px 40px #0A192F08; }
.brand { display: inline-flex; align-items: center; justify-content: center; padding: .25rem .65rem; margin-bottom: 1.3rem; border: 1px solid #E0F2FE; border-radius: .55rem; background: #E0F2FE; color: #0F2744; font-weight: 700; font-size: .82rem; letter-spacing: normal; }
.brand [dir="ltr"] { letter-spacing: .08em; }
.portal-footer { margin: 0 16px .75rem; text-align: center; color: #16335B; font-size: .72rem; }
h1 { color: #0F2744; font-size: 1.65rem; margin: 0 0 .7rem; line-height: 1.6; }
.description { color: #16335B; font-size: .88rem; line-height: 1.95; margin: 0 0 1.4rem; }
label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: .5rem; }
.input { display: block; width: 100%; border: 1px solid #E0F2FE; border-radius: .6rem; padding: .65rem .8rem; min-height: 3rem; color: #0F2744; background: #FFFFFF; }
.code { text-align: center; font-size: 1.8rem; letter-spacing: .25em; font-variant-numeric: tabular-nums; }
.input:focus { outline: 0; box-shadow: 0 0 0 .2rem #0284C71c; border-color: #0F2744; }
.help { color: #16335B; font-size: .76rem; line-height: 1.9; margin: .65rem 0 1.3rem; }
.button { width: 100%; border: 1px solid #0284C7; border-radius: .6rem; min-height: 3rem; padding: .65rem 1rem; cursor: pointer; font-weight: 600; font-size: .9rem; background: #0F2744; color: #FFFFFF; }
.button:hover { background: #0F2744; border-color: #0F2744; }
.button:focus-visible, summary:focus-visible, .cancel:focus-visible { outline: 3px solid #0284C7; outline-offset: 3px; }
.recovery { margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid #E0F2FE; }
.recovery summary { cursor: pointer; font-size: .8rem; color: #16335B; min-height: 2.75rem; padding-block: .35rem; }
.recovery summary::marker { color: #0F2744; }
.recovery form { margin-top: .9rem; }
.secondary { color: #16335B; border: 1px solid #E0F2FE; background: #FFFFFF; }
.secondary:hover { background: #F8FAFC; border-color: #E0F2FE; }
.cancel-form { margin-top: 1rem; text-align: center; }
.cancel { min-height: 2.75rem; background: none; border: 0; color: #16335B; cursor: pointer; font-size: .8rem; text-decoration: underline; text-underline-offset: .2em; }
.validation-summary-valid { display: none; }
.validation-summary-errors { padding: .8rem .9rem; background: #E0F2FE; border: 1px solid #E0F2FE; color: #0F2744; border-radius: .65rem; margin-bottom: 1.2rem; font-size: .83rem; }
.validation-summary-errors ul { margin: 0; padding-inline-start: 1.15rem; }
@@media (max-width: 480px) { .card { padding: 1.5rem 1.2rem; } }
    </style>
    <link rel="stylesheet" href="/wathiq-brand.css" />
</head>
<body>
    <main class="shell">
        <section class="card" aria-labelledby="verify-title">
            <span class="brand">وَثيق <span dir="ltr">| WATHIQ</span></span>
            <h1 id="verify-title">أدخل رمز التحقق</h1>
            <div asp-validation-summary="All" role="alert"></div>

            @if (Model.ChallengeAvailable)
            {
                <p class="description">أدخل الرمز من تطبيق المصادقة لإكمال تسجيل الدخول إلى بوابة وَثيق.</p>
                <form method="post" asp-page="/Account/LoginTwoFactor" asp-antiforgery="true">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <input type="hidden" name="Input.UseRecoveryCode" value="false" />
                    <label for="authenticator-code">رمز تطبيق المصادقة</label>
                    <input id="authenticator-code" name="Input.Code" type="text" dir="ltr" class="input code"
                           inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="12"
                           pattern="[0-9 -]{6,12}" required autofocus aria-describedby="authenticator-help" />
                    <p id="authenticator-help" class="help">الرمز مكوّن من 6 أرقام. استخدم الرمز الحالي الظاهر في التطبيق.</p>
                    <button type="submit" class="button">دخول</button>
                </form>
                @if (Model.CanUseRecoveryCodes)
                {
                    <details class="recovery" open="@Model.Input.UseRecoveryCode">
                        <summary>استخدام رمز استرداد بدلًا من رمز التطبيق</summary>
                        <form method="post" asp-page="/Account/LoginTwoFactor" asp-antiforgery="true">
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <input type="hidden" name="Input.UseRecoveryCode" value="true" />
                            <label for="recovery-code">رمز الاسترداد</label>
                            <input id="recovery-code" name="Input.RecoveryCode" type="password" dir="ltr" class="input"
                                   maxlength="128" autocomplete="off" spellcheck="false" required aria-describedby="recovery-help" />
                            <p id="recovery-help" class="help">كل رمز استرداد يُستخدم مرة واحدة فقط.</p>
                            <button type="submit" class="button secondary">دخول برمز الاسترداد</button>
                        </form>
                    </details>
                }
            }
            else
            {
                <p class="description">أعد تسجيل الدخول للمتابعة. إذا كان الحساب مقفلًا مؤقتًا، انتظر انتهاء مدة القفل.</p>
            }
            <form method="post" asp-page="/Account/LoginTwoFactor" asp-page-handler="Cancel"
                  asp-antiforgery="true" class="cancel-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="cancel">العودة إلى تسجيل الدخول</button>
            </form>
        </section>
    </main>
    <footer class="portal-footer">وَثيق | WATHIQ · بوابة التوثيق والمتابعة</footer>
</body>
</html>