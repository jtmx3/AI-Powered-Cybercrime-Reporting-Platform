@using System.Security.Claims
@using ACCP.Application.Notifications
@using ACCP.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager NavigationManager
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<div class="gov-sidebar">
    <div class="gov-sidebar-brand">
        <a href="" class="gov-brand-link" @onclick="CloseMenu">
            <div class="gov-crest" aria-hidden="true">
                <svg viewBox="0 0 40 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 2L5 8.5V20.5C5 30.8 11.4 39.6 20 42C28.6 39.6 35 30.8 35 20.5V8.5L20 2Z"
                          fill="#0F294A" stroke="#38BDF8" stroke-width="1.75"/>
                    <path d="M20 6.5L9 11.2V20.2C9 28.1 13.7 35.1 20 37.2C26.3 35.1 31 28.1 31 20.2V11.2L20 6.5Z"
                          stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
                    <path d="M14.5 21.5L18.2 25.2L26 17.4"
                          stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="square"/>
                    <line x1="14" y1="29.5" x2="26" y2="29.5" stroke="#38BDF8" stroke-width="1.8"/>
                </svg>
            </div>
            <div class="gov-brand-titles">
                <div class="gov-brand-name-row">
                    <span class="gov-brand-ar">وَثيق</span>
                    <span class="gov-brand-en">WATHIQ</span>
                </div>
                <span class="gov-brand-caption">منظومة البلاغات السيبرانية</span>
            </div>
        </a>

        <button type="button"
                class="gov-mobile-toggle"
                aria-label="تبديل القائمة"
                @onclick="ToggleMenu">
            <i class="bi @(menuOpen ? "bi-x-lg" : "bi-list")"></i>
        </button>
    </div>

    <nav class="gov-nav-container @(menuOpen ? "is-open" : "")" aria-label="القائمة الرئيسية">
        <div class="gov-nav-group">
            <span class="gov-nav-heading">البوابة العامة</span>
            <NavLink class="gov-nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <i class="bi bi-house-door gov-nav-icon" aria-hidden="true"></i>
                <span>الصفحة الرئيسية</span>
            </NavLink>
        </div>

        <AuthorizeView Roles="USER" Context="userRoleState">
            <Authorized>
                <div class="gov-nav-group">
                    <span class="gov-nav-heading">خدمات المشتكي</span>
                    <NavLink class="gov-nav-link" href="/cases/new" Match="NavLinkMatch.All" @onclick="CloseMenu">
                        <i class="bi bi-file-earmark-plus gov-nav-icon" aria-hidden="true"></i>
                        <span>تقديم وتوثيق بلاغ</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/cases" Match="NavLinkMatch.All" @onclick="CloseMenu">
                        <i class="bi bi-folder2-open gov-nav-icon" aria-hidden="true"></i>
                        <span>سجل الطلبات والبلاغات</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/conversations" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-chat-square-text gov-nav-icon" aria-hidden="true"></i>
                        <span>المحادثات الموثقة</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="OFFICER" Context="officerRoleState">
            <Authorized>
                <div class="gov-nav-group">
                    <span class="gov-nav-heading">أعمال التحقيق</span>
                    <NavLink class="gov-nav-link" href="/officer/dashboard" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-briefcase gov-nav-icon" aria-hidden="true"></i>
                        <span>لوحة متابعة القضايا</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="ADMIN" Context="adminRoleState">
            <Authorized>
                <div class="gov-nav-group">
                    <span class="gov-nav-heading">الإدارة والرقابة</span>
                    <NavLink class="gov-nav-link" href="/admin/employees" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-people gov-nav-icon" aria-hidden="true"></i>
                        <span>إدارة الكوادر والموظفين</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/admin/workload" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-diagram-3 gov-nav-icon" aria-hidden="true"></i>
                        <span>توزيع القضايا والأحمال</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/admin/staff-requests" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-arrow-left-right gov-nav-icon" aria-hidden="true"></i>
                        <span>طلبات النقل والمشاركة</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/admin/case-reopening" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-arrow-counterclockwise gov-nav-icon" aria-hidden="true"></i>
                        <span>إعادة فتح القضايا</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/admin/audit-logs" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                        <i class="bi bi-shield-check gov-nav-icon" aria-hidden="true"></i>
                        <span>سجل التدقيق الأمني</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Context="accountState">
            <Authorized>
                <div class="gov-nav-group gov-nav-footer">
                    <span class="gov-nav-heading">إدارة الحساب</span>
                    <NavLink class="gov-nav-link" href="/notifications" @onclick="CloseMenu">
                        <i class="bi bi-bell gov-nav-icon" aria-hidden="true"></i>
                        <span>الإشعارات الرسمية</span>
                        @if (unreadCount > 0)
                        {
                            <span class="gov-unread-badge">@unreadCount</span>
                        }
                    </NavLink>

                    <form action="account/logout" method="post" class="gov-logout-form">
                        <AntiforgeryToken />
                        <button type="submit" class="gov-logout-btn">
                            <i class="bi bi-box-arrow-right gov-nav-icon" aria-hidden="true"></i>
                            <span>إنهاء الجلسة والخروج</span>
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="gov-nav-group gov-nav-footer">
                    <span class="gov-nav-heading">النفاذ للمنصة</span>
                    <NavLink class="gov-nav-link" href="/login" @onclick="CloseMenu">
                        <i class="bi bi-box-arrow-in-left gov-nav-icon" aria-hidden="true"></i>
                        <span>تسجيل الدخول</span>
                    </NavLink>
                    <NavLink class="gov-nav-link" href="/register" @onclick="CloseMenu">
                        <i class="bi bi-person-plus gov-nav-icon" aria-hidden="true"></i>
                        <span>تسجيل حساب مستفيد</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private int unreadCount;
    private bool menuOpen;
    private bool componentDisposed;
    private AuthorizedNotificationService? notificationEvents;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;

        notificationEvents = NotificationService as AuthorizedNotificationService;
        if (notificationEvents is not null)
        {
            notificationEvents.ReadStateChanged += HandleNotificationReadChanged;
        }

        await RefreshUnreadCountAsync();
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private async Task RefreshUnreadCountAsync()
    {
        if (componentDisposed) return;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(idClaim, out var userId))
                {
                    unreadCount = await NotificationService.GetUnreadCountAsync(userId);
                    if (!componentDisposed)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            else
            {
                unreadCount = 0;
            }
        }
        catch
        {
            unreadCount = 0;
        }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        await RefreshUnreadCountAsync();
    }

    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await RefreshUnreadCountAsync();
    }

    private async void HandleNotificationReadChanged()
    {
        await RefreshUnreadCountAsync();
    }

    public void Dispose()
    {
        componentDisposed = true;
        NavigationManager.LocationChanged -= HandleLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
        if (notificationEvents is not null)
        {
            notificationEvents.ReadStateChanged -= HandleNotificationReadChanged;
        }
    }
}
