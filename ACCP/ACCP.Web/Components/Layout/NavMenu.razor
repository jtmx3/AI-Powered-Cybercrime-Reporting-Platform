@using System.Security.Claims
@using ACCP.Application.Notifications
@using ACCP.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager NavigationManager
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<div class="wathiq-sidebar">
    <input type="checkbox" id="wathiq-drawer-toggle" class="wathiq-drawer-checkbox" aria-hidden="true" />

    <div class="wathiq-brand-box">
        <a href="" class="wathiq-brand-anchor">
            <div class="wathiq-emblem" aria-hidden="true">
                <svg width="42" height="42" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M32 4L8 14V31C8 46.8 18.2 58.6 32 62C45.8 58.6 56 46.8 56 31V14L32 4Z" fill="#0B2240"/>
                    <path d="M32 8.5L12.5 17V30.8C12.5 43.9 20.8 53.9 32 57C43.2 53.9 51.5 43.9 51.5 30.8V17L32 8.5Z" stroke="#0EA5E9" stroke-width="2.2"/>
                    <path d="M22 22H42V25.2H22V22ZM22 29H36V32.2H22V29Z" fill="#38BDF8"/>
                    <path d="M23.5 38.5L29.5 44.5L42.5 31.5" stroke="#FFFFFF" stroke-width="4" stroke-linecap="square"/>
                </svg>
            </div>
            <div class="wathiq-brand-meta">
                <div class="wathiq-brand-row">
                    <span class="wathiq-name-ar">وَثيق</span>
                    <span class="wathiq-name-en">WATHIQ</span>
                </div>
                <span class="wathiq-brand-desc">البوابة الوطنية للبلاغات السيبرانية</span>
            </div>
        </a>

        <label for="wathiq-drawer-toggle" class="wathiq-burger" aria-label="فتح أو إغلاق القائمة">
            <i class="bi bi-list"></i>
        </label>
    </div>

    <nav class="wathiq-nav-scroll" aria-label="التنقل الرئيسي">
        <div class="wathiq-nav-section">
            <span class="wathiq-section-label">البوابة الرئيسية</span>
            <NavLink class="wathiq-nav-item" href="" Match="NavLinkMatch.All">
                <span class="wathiq-icon-box"><i class="bi bi-grid-1x2" aria-hidden="true"></i></span>
                <span class="wathiq-item-text">الصفحة الرئيسية</span>
            </NavLink>
        </div>

        <AuthorizeView Roles="USER" Context="userRoleState">
            <Authorized>
                <div class="wathiq-nav-section">
                    <span class="wathiq-section-label">خدمات المبلّغين</span>
                    <NavLink class="wathiq-nav-item" href="/cases/new" Match="NavLinkMatch.All">
                        <span class="wathiq-icon-box"><i class="bi bi-shield-plus" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">توثيق بلاغ جديد</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/cases" Match="NavLinkMatch.All">
                        <span class="wathiq-icon-box"><i class="bi bi-folder2-open" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">طلباتي وبلاغاتي</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/conversations" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-chat-right-quote" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">المحادثات المحفوظة</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="OFFICER" Context="officerRoleState">
            <Authorized>
                <div class="wathiq-nav-section">
                    <span class="wathiq-section-label">وحدة التحقيق المختص</span>
                    <NavLink class="wathiq-nav-item" href="/officer/dashboard" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-briefcase" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">لوحة متابعة القضايا</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="ADMIN" Context="adminRoleState">
            <Authorized>
                <div class="wathiq-nav-section">
                    <span class="wathiq-section-label">الإدارة والحوكمة</span>
                    <NavLink class="wathiq-nav-item" href="/admin/employees" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-people" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">إدارة الموظفين</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/admin/workload" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">توزيع القضايا والأحمال</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/admin/staff-requests" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">طلبات النقل والمشاركة</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/admin/case-reopening" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">إعادة فتح القضايا</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/admin/audit-logs" Match="NavLinkMatch.Prefix">
                        <span class="wathiq-icon-box"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">سجل التدقيق الأمني</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Context="accountState">
            <Authorized>
                <div class="wathiq-nav-section wathiq-nav-bottom">
                    <span class="wathiq-section-label">الحساب والإشعارات</span>
                    <NavLink class="wathiq-nav-item" href="/notifications">
                        <span class="wathiq-icon-box"><i class="bi bi-bell" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">الإشعارات</span>
                        @if (unreadCount > 0)
                        {
                            <span class="wathiq-count-pill">@unreadCount</span>
                        }
                    </NavLink>

                    <form action="/logout" method="post" class="wathiq-logout-wrap">
                        <AntiforgeryToken />
                        <button type="submit" class="wathiq-logout-btn">
                            <span class="wathiq-icon-box"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></span>
                            <span class="wathiq-item-text">تسجيل الخروج الآمن</span>
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="wathiq-nav-section wathiq-nav-bottom">
                    <span class="wathiq-section-label">بوابة النفاذ</span>
                    <NavLink class="wathiq-nav-item" href="/login">
                        <span class="wathiq-icon-box"><i class="bi bi-box-arrow-in-left" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">تسجيل الدخول</span>
                    </NavLink>
                    <NavLink class="wathiq-nav-item" href="/register">
                        <span class="wathiq-icon-box"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
                        <span class="wathiq-item-text">إنشاء حساب مستفيد</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private int unreadCount;
    private bool componentDisposed;
    private AuthorizedNotificationService? notificationEvents;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        notificationEvents = NotificationService as AuthorizedNotificationService;
        if (notificationEvents is not null)
        {
            notificationEvents.ReadStateChanged += HandleNotificationReadChanged;
        }
        await RefreshUnreadCountAsync();
    }

    private async Task RefreshUnreadCountAsync()
    {
        if (componentDisposed) return;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(idClaim, out var userId))
                {
                    unreadCount = await NotificationService.GetUnreadCountAsync(userId);
                    if (!componentDisposed) await InvokeAsync(StateHasChanged);
                }
            }
            else { unreadCount = 0; }
        }
        catch { unreadCount = 0; }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => await RefreshUnreadCountAsync();
    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task) => await RefreshUnreadCountAsync();
    private async void HandleNotificationReadChanged() => await RefreshUnreadCountAsync();

    public void Dispose()
    {
        componentDisposed = true;
        NavigationManager.LocationChanged -= HandleLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
        if (notificationEvents is not null) notificationEvents.ReadStateChanged -= HandleNotificationReadChanged;
    }
}
