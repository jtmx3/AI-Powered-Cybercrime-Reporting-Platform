@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="wathiq-app-layout" dir="rtl">
    <aside class="sidebar-wrapper">
        <NavMenu />
    </aside>

    <div class="content-wrapper">
        <header class="top-nav-bar">
            <div class="header-safety-tag">
                <span class="safety-dot"></span>
                <span>نظام مشفر ومحمي لمكافحة الجرائم السيبرانية</span>
            </div>

            <div class="header-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="user-greeting">
                            أهلاً بك، <strong>@(context.User.Identity?.Name ?? "المستخدم")</strong>
                        </span>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="login-quick-link">تسجيل الدخول</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="page-body">
            @Body
        </main>
    </div>
</div>
