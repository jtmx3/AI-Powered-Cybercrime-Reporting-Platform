@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<div class="wathiq-shell" dir="rtl">
    <aside class="wathiq-aside">
        <NavMenu />
    </aside>

    <div class="wathiq-viewport">
        <details class="gov-trust-bar">
            <summary class="gov-trust-summary">
                <div class="gov-trust-right">
                    <i class="bi bi-shield-lock-fill gov-trust-shield" aria-hidden="true"></i>
                    <span>بوابة إلكترونية رسمية لمنظومة <strong>«وَثيق»</strong> لتوثيق ومتابعة الجرائم السيبرانية</span>
                </div>
                <span class="gov-trust-trigger">
                    <span>كيف تتحقق من موثوقية المنصة؟</span>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </summary>
            <div class="gov-trust-panel">
                <div class="gov-trust-item">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                    <div>
                        <strong>اتصال مشفر وحفظ جنائي للقرائن</strong>
                        <p>تُشفر جلسات التواصل وتُحفظ المرفقات ببصمة رقمية (SHA-256) تمنع التعديل غير المصرح به وتضمن سلامة سلسلة الحيازة.</p>
                    </div>
                </div>
                <div class="gov-trust-item">
                    <i class="bi bi-eye-slash-fill" aria-hidden="true"></i>
                    <div>
                        <strong>حجب تلقائي للهوية وفصل للصلاحيات</strong>
                        <p>لا تُكشف بياناتك الشخصية للمحقق إلا بموافقتك الصريحة، ولا تملك الإدارة التشغيلية صلاحية قراءة نصوص الشكاوى.</p>
                    </div>
                </div>
            </div>
        </details>

        <header class="wathiq-header">
            <div class="wathiq-header-context">
                <span class="context-org">منظومة وَثيق (WATHIQ)</span>
                <span class="context-sep" aria-hidden="true">/</span>
                <span class="context-sub">الخدمات الإلكترونية للبلاغات الرقمية</span>
            </div>

            <div class="wathiq-header-user">
                <AuthorizeView Context="authState">
                    <Authorized>
                        <a href="/notifications" class="header-icon-link" title="الإشعارات">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                        </a>
                        <div class="header-account-pill">
                            <i class="bi bi-person-check-fill" aria-hidden="true"></i>
                            <span class="account-name">@(authState.User.Identity?.Name ?? "مستخدم موثّق")</span>
                            <span class="account-role">@GetRoleTitle(authState.User)</span>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="header-guest-btns">
                            <a href="/login" class="header-btn-outline">تسجيل الدخول</a>
                            <a href="/register" class="header-btn-solid">حساب مستفيد جديد</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="wathiq-main-content">
            @Body
        </main>

        <footer class="wathiq-footer">
            <div class="wathiq-footer-grid">
                <div class="footer-brand-col">
                    <strong>منظومة وَثيق | WATHIQ</strong>
                    <span>المنصة الرسمية لاستقبال وتوثيق ومتابعة البلاغات السيبرانية وفق ضوابط السرية وحماية البيانات.</span>
                </div>
                <div class="footer-meta-col">
                    <span>جميع الحقوق محفوظة © @DateTime.UtcNow.Year منظومة وَثيق</span>
                </div>
            </div>
        </footer>
    </div>
</div>

@code {
    private static string GetRoleTitle(ClaimsPrincipal user)
    {
        if (user.IsInRole("ADMIN")) return "إدارة النظام";
        if (user.IsInRole("OFFICER")) return "ضابط تحقيق";
        if (user.IsInRole("USER")) return "مستفيد";
        return "حساب نشط";
    }
}