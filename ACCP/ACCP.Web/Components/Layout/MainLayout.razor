@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<div class="gov-portal-shell" dir="rtl">
    <aside class="gov-sidebar-area">
        <NavMenu />
    </aside>

    <div class="gov-main-area">
        <div class="gov-official-banner">
            <div class="gov-banner-inner">
                <div class="gov-banner-right">
                    <i class="bi bi-shield-lock-fill gov-banner-icon" aria-hidden="true"></i>
                    <span>البوابة الرسمية لمنظومة «وَثيق» — اتصال مشفر ومؤمّن وفق المعايير الوطنية</span>
                </div>
                <div class="gov-banner-left">
                    <span>WATHIQ OFFICIAL PORTAL</span>
                </div>
            </div>
        </div>

        <header class="gov-topbar">
            <div class="gov-topbar-title">
                <span class="gov-org-label">منظومة مكافحة الجرائم السيبرانية</span>
                <span class="gov-divider" aria-hidden="true">|</span>
                <span class="gov-system-label">بوابة التوثيق والمتابعة الإجرائية</span>
            </div>

            <div class="gov-topbar-user">
                <AuthorizeView Context="authState">
                    <Authorized>
                        <div class="gov-user-chip">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                            <span class="gov-user-email">@(authState.User.Identity?.Name ?? "حساب موثّق")</span>
                            <span class="gov-role-tag">@GetRoleLabel(authState.User)</span>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="gov-guest-actions">
                            <a href="/login" class="gov-top-link">
                                <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i>
                                <span>تسجيل الدخول</span>
                            </a>
                            <a href="/register" class="gov-top-btn">
                                <span>حساب مستفيد جديد</span>
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="gov-content-body">
            @Body
        </main>

        <footer class="gov-footer">
            <div class="gov-footer-inner">
                <span>© @DateTime.UtcNow.Year منظومة «وَثيق» (WATHIQ) — البوابة الرسمية لتوثيق الجرائم السيبرانية.</span>
                <span class="gov-footer-meta">تخضع جميع المرفقات والسجلات لضوابط السرية وسلسلة الحيازة الرقمية المعتمدة.</span>
            </div>
        </footer>
    </div>
</div>

@code {
    private static string GetRoleLabel(ClaimsPrincipal user)
    {
        if (user.IsInRole("ADMIN")) return "إدارة النظام";
        if (user.IsInRole("OFFICER")) return "ضابط تحقيق";
        if (user.IsInRole("USER")) return "مستفيد";
        return "مستخدم";
    }
}
