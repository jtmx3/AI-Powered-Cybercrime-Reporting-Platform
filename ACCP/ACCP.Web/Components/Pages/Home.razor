@page "/"
@using ACCP.Application.Cases
@using ACCP.Domain.Entities
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>وَثيق | المنصة الآمنة لتوثيق ومتابعة البلاغات السيبرانية</PageTitle>

<div class="home-container" dir="rtl">
    <section class="hero-card">
        <div class="hero-content">
            <div class="brand-pill">
                <span class="pill-dot"></span>
                <span>المنصة الوطنية للتوثيق السيبراني الجنائي</span>
            </div>

            <h1 class="hero-title">
                منصة <span class="highlight-wathiq">وَثـيـق</span> للبلاغات الرقمية
            </h1>

            <p class="hero-lead">
                حقك الرقمي محفوظ بسرية تامة. نوفر لك بيئة رسمية ومحمية لتوثيق حالات الابتزاز، 
                الاحتيال المالي، واختراق الحسابات، مع ربط بلاغك بمحققين مختصين لمتابعة الإجراءات فوراً.
            </p>

            <div class="hero-actions">
                <AuthorizeView>
                    <Authorized>
                        <a href="/cases/new" class="btn-wathiq-primary">
                            <span>بدء توثيق بلاغ جديد</span>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <a href="/cases" class="btn-wathiq-secondary">
                            <span>متابعة بلاغاتي</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn-wathiq-primary">
                            <span>تسجيل الدخول لتقديم بلاغ</span>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <a href="/register" class="btn-wathiq-secondary">
                            <span>إنشاء حساب مشتكي آمن</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="trust-strip">
                <div class="trust-item">
                    <span class="trust-icon">🔒</span>
                    <div>
                        <strong>سرية وحماية مطلقة</strong>
                        <small>بياناتك وهويتك محمية ولا تكشف إلا بموافقتك</small>
                    </div>
                </div>
                <div class="trust-item">
                    <span class="trust-icon">🛡️</span>
                    <div>
                        <strong>تحقيق رسمي ومخول</strong>
                        <small>متابعة مباشرة من موظفين أمنيين مختصين</small>
                    </div>
                </div>
                <div class="trust-item">
                    <span class="trust-icon">📑</span>
                    <div>
                        <strong>حفظ مشفر للأدلة</strong>
                        <small>سجل جنائي للأدلة والروابط لمنع التلاعب</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-block">
        <div class="section-header text-center">
            <span class="section-badge">كيف تعمل المنصة</span>
            <h2 class="section-heading">خطوات توثيق ومتابعة بلاغك</h2>
            <p class="section-desc">آلية واضحة ومبسطة تضمن سرعة الاستجابة لشكواك وحفظ حقوقك</p>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">01</div>
                <div class="step-icon">💬</div>
                <h3>سرد الواقعة وحفظ المحادثة</h3>
                <p>اكتب ما تعرضت له بأمان وتفصيل. يتم حفظ أقوالك وتوثيق تسلسل الأحداث بنظام رقمي سري.</p>
            </div>

            <div class="step-card">
                <div class="step-number">02</div>
                <div class="step-icon">📎</div>
                <h3>إرفاق وتوثيق الأدلة</h3>
                <p>ارفع لقطات الشاشة، أرقام الهواتف، والروابط المشبوهة، مع حفظ بصمة رقمية مشفرة (Hash) لكل ملف.</p>
            </div>

            <div class="step-card highlight">
                <div class="step-number">03</div>
                <div class="step-icon">👮</div>
                <h3>استلام المحقق والمتابعة</h3>
                <p>يستلم موظف مختص ملف القضية لدراسته والتواصل المباشر معك ومتابعة سير الإجراءات لحظة بلحظة.</p>
            </div>
        </div>
    </section>

    <section class="section-block">
        <div class="section-header text-center">
            <span class="section-badge">إرشادات وأسئلة</span>
            <h2 class="section-heading">إجابات تساعدك على حماية حقك</h2>
            <p class="section-desc">كل ما تحتاج معرفته عن خصوصية بلاغك وإجراءات المتابعة</p>
        </div>

        <div class="faq-grid">
            <div class="faq-card">
                <div class="faq-q">
                    <span class="q-icon">؟</span>
                    <h4>هل تظهر هويتي أو اسمي للموظف فور تقديم البلاغ؟</h4>
                </div>
                <p class="faq-a">
                    لا، المنصة مصممة بسياسة خصوصية صارمة؛ تظل هويتك محجوبة عن الموظف ومسجلة برمز مشفر، 
                    ولا يتم إظهار اسمك أو بريدك إلا إذا منحت موافقة صريحة بكشف الهوية للتحقيق.
                </p>
            </div>

            <div class="faq-card">
                <div class="faq-q">
                    <span class="q-icon">؟</span>
                    <h4>ما هي أنواع البلاغات التي تختص بها « وَثيق »؟</h4>
                </div>
                <p class="faq-a">
                    تشمل جرائم الابتزاز الإلكتروني، الاحتيال المالي وسرقة البطاقات، اختراق الحسابات 
                    الشخصية أو المؤسسية، انتحال الشخصية، والتهديدات الرقمية عبر شبكات التواصل.
                </p>
            </div>

            <div class="faq-card">
                <div class="faq-q">
                    <span class="q-icon">؟</span>
                    <h4>ماذا أفعل في حال تم تعديل الدليل أو إضافة دليل جديد لاحقاً؟</h4>
                </div>
                <p class="faq-a">
                    تتيح لك المنصة رفع نسخ جديدة من الأدلة مع تسجيل سبب التعديل، مع بقاء النسخة 
                    الأصلية محفوظة وموثقة جنائياً لضمان سلامة سلسلة الأدلة (Chain of Custody).
                </p>
            </div>

            <div class="faq-card">
                <div class="faq-q">
                    <span class="q-icon">؟</span>
                    <h4>كيف أعرف التحديثات على بلاغي بعد إرساله؟</h4>
                </div>
                <p class="faq-a">
                    ستصلك إشعارات فورية على حسابك عند استلام القضية من محقق، أو عند كتابة رسالة لك، 
                    أو عند انتقال البلاغ لمرحلة قيد المعالجة أو الحل.
                </p>
            </div>
        </div>
    </section>
</div>
