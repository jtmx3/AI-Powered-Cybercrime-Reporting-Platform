@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>وَثيق | البوابة الرسمية لتوثيق ومتابعة البلاغات السيبرانية</PageTitle>

<div class="gov-home" dir="rtl">
    <!-- القسم الترحيبي السيادي -->
    <section class="gov-masthead" aria-labelledby="masthead-heading">
        <div class="gov-masthead-grid">
            <div class="gov-masthead-main">
                <div class="gov-classification">
                    <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                    <span>منظومة التوثيق الجنائي الرقمي المعتمدة</span>
                </div>

                <h1 id="masthead-heading" class="gov-masthead-title">
                    منصة «وَثيق» لاستقبال ومتابعة البلاغات السيبرانية
                </h1>

                <p class="gov-masthead-desc">
                    قناة رسمية مؤمّنة تتيح للمتضررين توثيق وقائع الجرائم الإلكترونية وحفظ القرائن الرقمية
                    بسرية تامة، مع إسناد البلاغات إلى محققين مختصين ضمن مسار إجرائي خاضع للرقابة والتدقيق.
                </p>

                <div class="gov-masthead-actions">
                    <AuthorizeView Context="auth">
                        <Authorized>
                            @if (auth.User.IsInRole("ADMIN"))
                            {
                                <a href="/admin/employees" class="btn-gov-primary">
                                    <span>الدخول إلى لوحة الإدارة</span>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </a>
                                <a href="/admin/audit-logs" class="btn-gov-secondary">
                                    <span>مراجعة سجل التدقيق</span>
                                </a>
                            }
                            else if (auth.User.IsInRole("OFFICER"))
                            {
                                <a href="/officer/dashboard" class="btn-gov-primary">
                                    <span>فتح لوحة متابعة القضايا</span>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </a>
                            }
                            else
                            {
                                <a href="/cases/new" class="btn-gov-primary">
                                    <span>بدء توثيق بلاغ جديد</span>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </a>
                                <a href="/cases" class="btn-gov-secondary">
                                    <span>استعراض البلاغات السابقة</span>
                                </a>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn-gov-primary">
                                <span>بدء خدمة توثيق بلاغ</span>
                                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            </a>
                            <a href="/register" class="btn-gov-secondary">
                                <span>تسجيل حساب مستفيد جديد</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <aside class="gov-assurance-panel" aria-label="الضمانات الأمنية والخصوصية">
                <h2 class="gov-assurance-heading">ضمانات الحماية والسرية المعتمدة</h2>
                <ul class="gov-assurance-list">
                    <li>
                        <div class="gov-assurance-icon">
                            <i class="bi bi-person-lock" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>حماية وحجب هوية المشتكي</strong>
                            <p>تُحجب البيانات الشخصية للمشتكي افتراضياً ولا تُتاح للمحقق المختص إلا بإقرار صريح وموثق من صاحب العلاقة.</p>
                        </div>
                    </li>
                    <li>
                        <div class="gov-assurance-icon">
                            <i class="bi bi-file-earmark-lock2" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>سلامة سلسلة حيازة الأدلة (SHA-256)</strong>
                            <p>تُحفظ المرفقات والنسخ المعدلة ببصمة تشفيرية رقمية تمنع التلاعب وتضمن حجيتها الفنية.</p>
                        </div>
                    </li>
                    <li>
                        <div class="gov-assurance-icon">
                            <i class="bi bi-journal-check" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>فصل الصلاحيات وسجل التدقيق</strong>
                            <p>لا تتيح الصلاحيات الإدارية الاطلاع على مضمون الشكاوى الخاصة، ويُسجل كل إجراء وصول في سجل رقابي.</p>
                        </div>
                    </li>
                </ul>
            </aside>
        </div>
    </section>

    <!-- آلية العمل النظامية -->
    <section class="gov-section" aria-labelledby="workflow-heading">
        <div class="gov-section-head">
            <div>
                <span class="gov-kicker">الإجراءات النظامية</span>
                <h2 id="workflow-heading" class="gov-section-title">آلية تقديم ومتابعة البلاغ عبر «وَثيق»</h2>
            </div>
            <p class="gov-section-sub">مسار إلكتروني موحّد من ثلاث مراحل يضمن دقة التوثيق وسرعة المعالجة المختصة.</p>
        </div>

        <div class="gov-workflow-grid">
            <article class="gov-step-box">
                <div class="gov-step-top">
                    <span class="gov-step-num">المرحلة 01</span>
                    <i class="bi bi-chat-right-text gov-step-icon" aria-hidden="true"></i>
                </div>
                <h3>التوثيق المبدئي لملابسات الواقعة</h3>
                <p>تدوين تفاصيل الحادثة السيبرانية عبر جلسة محادثة محمية تُحفظ تلقائياً في حسابك دون إرسال رسمي إلا بعد مراجعتك واعتمادك.</p>
            </article>

            <article class="gov-step-box">
                <div class="gov-step-top">
                    <span class="gov-step-num">المرحلة 02</span>
                    <i class="bi bi-paperclip gov-step-icon" aria-hidden="true"></i>
                </div>
                <h3>إيداع القرائن والمرفقات الرقمية</h3>
                <p>إرفاق المستندات والصور ذات الصلة بالبلاغ مع التحكم الكامل بصلاحية إفصاح المرفقات المقيدة للمحقق وتوثيق سجل الإصدارات.</p>
            </article>

            <article class="gov-step-box gov-step-active">
                <div class="gov-step-top">
                    <span class="gov-step-num">المرحلة 03</span>
                    <i class="bi bi-shield-check gov-step-icon" aria-hidden="true"></i>
                </div>
                <h3>الإحالة للمحقق والمتابعة المباشرة</h3>
                <p>استلام البلاغ من قِبل ضابط تحقيق مخوّل، وتلقي التحديثات والرسائل الرسمية حول حالة القضية حتى إغلاقها النظامي.</p>
            </article>
        </div>
    </section>

    <!-- ضوابط وإجابات المتابعة -->
    <section class="gov-section" aria-labelledby="guidance-heading">
        <div class="gov-section-head">
            <div>
                <span class="gov-kicker">الدليل الإرشادي للمستفيد</span>
                <h2 id="guidance-heading" class="gov-section-title">إجابات وضوابط تساعدك على المتابعة الآمنة</h2>
            </div>
            <p class="gov-section-sub">توضيحات رسمية حول سرية البيانات، إدارة المرفقات، وآليات التواصل مع المختصين.</p>
        </div>

        <div class="gov-faq-container">
            <details class="gov-accordion" open>
                <summary>
                    <span>هل يطّلع الموظف أو مدير النظام على بياناتي الشخصية فور رفع البلاغ؟</span>
                    <i class="bi bi-chevron-down gov-acc-chevron" aria-hidden="true"></i>
                </summary>
                <div class="gov-accordion-body">
                    تلتزم منصة «وَثيق» بمبدأ الحد الأدنى من كشف البيانات؛ حيث يتعامل المحقق المختص مع رقم القضية ووقائعها دون ظهور اسمك أو بريدك الإلكتروني إلا إذا اخترت تفعيل خيار «الإفصاح عن الهوية». كما تقتصر صلاحية مدير النظام على الجوانب التشغيلية وتوزيع الأحمال دون صلاحية قراءة نصوص الشكاوى أو فتح الأدلة.
                </div>
            </details>

            <details class="gov-accordion">
                <summary>
                    <span>ما الفرق بين حفظ المحادثة وتقديم البلاغ الرسمي؟</span>
                    <i class="bi bi-chevron-down gov-acc-chevron" aria-hidden="true"></i>
                </summary>
                <div class="gov-accordion-body">
                    عند كتابة تفاصيل المشكلة في صفحة التوثيق، تُحفظ الرسائل في مساحتك الخاصة لتتمكن من استكمالها في أي وقت. ولا يتحول الطلب إلى «بلاغ رسمي» يُحال لطابور المحققين إلا بعد استيفاء التقييم وموافقتك الصريحة على الإرسال.
                </div>
            </details>

            <details class="gov-accordion">
                <summary>
                    <span>كيف يتم التعامل مع تعديل الأدلة الرقمية أو استبدالها بعد رفعها؟</span>
                    <i class="bi bi-chevron-down gov-acc-chevron" aria-hidden="true"></i>
                </summary>
                <div class="gov-accordion-body">
                    حفاظاً على سلامة الإجراءات الجنائية، تتيح المنصة إرفاق نسخة محدثة من الدليل مع إلزامية تدوين سبب التعديل، بينما تظل النسخة الأصلية وكافة الإصدارات السابقة محفوظة برقم إصدار متسلسل وتوقيت زمني دقيق للمراجعة المختصة.
                </div>
            </details>

            <details class="gov-accordion">
                <summary>
                    <span>ما هي المعلومات التي يُنصح بتجهيزها، وما الذي يجب الامتناع عن إرساله؟</span>
                    <i class="bi bi-chevron-down gov-acc-chevron" aria-hidden="true"></i>
                </summary>
                <div class="gov-accordion-body">
                    يُنصح بتدوين التسلسل الزمني للواقعة، أسماء الحسابات أو الروابط محل الاشتباه، وإرفاق لقطات شاشة واضحة بصيغة PDF أو صور قياسية. ويُحظر تماماً كتابة كلمات المرور الخاصة بك أو رموز التحقق المؤقتة (OTP) أو الأرقام السرية للبطاقات البنكية داخل المحادثات.
                </div>
            </details>
        </div>
    </section>
</div>
