@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>وَثيق | المنصة الوطنية لتوثيق ومتابعة البلاغات السيبرانية</PageTitle>

<div class="wathiq-home" dir="rtl">
    <section class="service-hero" aria-labelledby="service-main-title">
        <div class="service-hero-layout">
            <div class="service-hero-welcome">
                <div class="service-official-tag">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>خدمة إلكترونية رسمية · خصوصية محمية</span>
                </div>

                <h1 id="service-main-title" class="service-title">
                    أنت في مساحة آمنة ومحمية.. وثّق بلاغك السيبراني عبر «وَثيق» بثقة وسرية تامة
                </h1>

                <p class="service-lead">
                    توفّر منظومة «وَثيق» قناة رسمية مشفرة لاستقبال وقائع الابتزاز الإلكتروني، الاحتيال المالي،
                    واختراق الحسابات. تُحفظ أقوالك وقرائنك الرقمية بأمان، وتبقى هويتك الشخصية محجوبة افتراضياً،
                    ولا يُقدَّم أي بلاغ رسمي إلا بعد مراجعتك وموافقتك الصريحة.
                </p>

                <div class="service-cta-row">
                    <AuthorizeView Context="auth">
                        <Authorized>
                            @if (auth.User.IsInRole("ADMIN"))
                            {
                                <a href="/admin/employees" class="cta-primary-btn">
                                    <span>الدخول إلى إدارة المنصة</span>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </a>
                            }
                            else if (auth.User.IsInRole("OFFICER"))
                            {
                                <a href="/officer/dashboard" class="cta-primary-btn">
                                    <span>فتح لوحة متابعة القضايا</span>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </a>
                            }
                            else
                            {
                                <a href="/cases/new" class="cta-primary-btn">
                                    <span>بدء توثيق بلاغ جديد</span>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </a>
                                <a href="/cases" class="cta-quiet-link">
                                    <span>متابعة حالة بلاغ سابق</span>
                                </a>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="cta-primary-btn">
                                <span>بدء خدمة توثيق بلاغ</span>
                                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            </a>
                            <a href="/register" class="cta-quiet-link">
                                <span>ليس لديك حساب؟ تسجيل مستفيد جديد</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <aside class="service-spec-card" aria-label="بطاقة بيانات الخدمة">
                <div class="spec-card-header">
                    <i class="bi bi-card-checklist" aria-hidden="true"></i>
                    <h2>بطاقة الضمانات وبيانات الخدمة</h2>
                </div>
                <dl class="spec-list">
                    <div class="spec-row">
                        <dt><i class="bi bi-person-lock" aria-hidden="true"></i> سرية هوية المبلّغ</dt>
                        <dd>محجوبة تلقائياً ولا تُفصح إلا بإقرارك</dd>
                    </div>
                    <div class="spec-row">
                        <dt><i class="bi bi-fingerprint" aria-hidden="true"></i> توثيق المرفقات</dt>
                        <dd>بصمة جنائية رقمية (SHA-256) وسجل إصدارات</dd>
                    </div>
                    <div class="spec-row">
                        <dt><i class="bi bi-sliders" aria-hidden="true"></i> التحكم بالإرسال</dt>
                        <dd>حفظ خاص للمحادثة قبل الاعتماد الرسمي</dd>
                    </div>
                    <div class="spec-row">
                        <dt><i class="bi bi-check2-circle" aria-hidden="true"></i> رسوم الخدمة</dt>
                        <dd><span class="spec-free-badge">خدمة مجانية بالكامل</span></dd>
                    </div>
                </dl>
            </aside>
        </div>
    </section>

    <section class="home-section" aria-labelledby="process-heading">
        <div class="section-header-bar">
            <div>
                <span class="section-overline">مسار المعالجة النظامي</span>
                <h2 id="process-heading" class="section-title">خطوات البداية وآلية عمل المنصة</h2>
            </div>
            <p class="section-subtitle">أربع مراحل مترابطة توضح رحلة البلاغ من لحظة التدوين السري وحتى المعالجة المختصة.</p>
        </div>

        <div class="process-timeline">
            <article class="process-step">
                <div class="step-marker-row">
                    <span class="step-circle">01</span>
                    <span class="step-connector" aria-hidden="true"></span>
                </div>
                <div class="step-card-body">
                    <div class="step-title-row">
                        <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                        <h3>التدوين الآمن للواقعة</h3>
                    </div>
                    <p>افتح محادثة خاصة ودون تفاصيل ما حدث بتسلسله الزمني. تُحفظ الرسائل فوراً في مساحتك الخاصة دون إرسالها لأي جهة.</p>
                    <span class="step-state-tag">الحالة: مسودة محادثة خاصة بحسابك</span>
                </div>
            </article>

            <article class="process-step">
                <div class="step-marker-row">
                    <span class="step-circle">02</span>
                    <span class="step-connector" aria-hidden="true"></span>
                </div>
                <div class="step-card-body">
                    <div class="step-title-row">
                        <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                        <h3>المراجعة واعتماد التقديم</h3>
                    </div>
                    <p>عند اكتمال التقييم الأولي، تستعرض ملخص البلاغ المصنّف وتؤكد موافقتك الصريحة لتحويله إلى بلاغ رسمي معتمد.</p>
                    <span class="step-state-tag">المخرج: إصدار رقم قضية مرجعي رسمي</span>
                </div>
            </article>

            <article class="process-step">
                <div class="step-marker-row">
                    <span class="step-circle">03</span>
                    <span class="step-connector" aria-hidden="true"></span>
                </div>
                <div class="step-card-body">
                    <div class="step-title-row">
                        <i class="bi bi-file-earmark-lock" aria-hidden="true"></i>
                        <h3>إيداع القرائن والأدلة</h3>
                    </div>
                    <p>ارفع الصور والمستندات المرتبطة بالحادثة مع تحكمك الكامل بصلاحية إفصاح كل مرفق للمحقق وتوثيق أي تحديث لاحق.</p>
                    <span class="step-state-tag">الحماية: سلسلة حيازة رقمية موثقة</span>
                </div>
            </article>

            <article class="process-step process-step-final">
                <div class="step-marker-row">
                    <span class="step-circle">04</span>
                </div>
                <div class="step-card-body">
                    <div class="step-title-row">
                        <i class="bi bi-person-workspace" aria-hidden="true"></i>
                        <h3>إسناد المحقق والمتابعة</h3>
                    </div>
                    <p>يستلم ضابط تحقيق مخوّل ملف القضية لدراسته ومراسلتك عبر قناة البلاغ المشفرة مع إشعارك الفوري بكل تحديث.</p>
                    <span class="step-state-tag step-state-sky">المتابعة: تواصل مباشر وإشعارات حالة</span>
                </div>
            </article>
        </div>
    </section>

    <section class="home-section" aria-labelledby="guidance-heading">
        <div class="section-header-bar">
            <div>
                <span class="section-overline">دليل المستفيد</span>
                <h2 id="guidance-heading" class="section-title">إجابات وإرشادات تساعدك على المتابعة</h2>
            </div>
            <p class="section-subtitle">معلومات واضحة حول خصوصيتك، تجهيز الأدلة، وآلية متابعة الإجراءات بعد التقديم.</p>
        </div>

        <div class="guidance-layout">
            <aside class="safety-callout-box" aria-label="تنبيهات أمنية هامة">
                <div class="callout-top">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                    <h3>ضوابط هامة لسلامة بلاغك</h3>
                </div>
                <ul class="safety-rules">
                    <li>
                        <i class="bi bi-x-octagon" aria-hidden="true"></i>
                        <span><strong>لا تشارك الرموز السرية:</strong> امتنع تماماً عن كتابة كلمات المرور أو رموز التحقق المؤقتة (OTP) أو أرقام البطاقات السرية داخل المحادثة.</span>
                    </li>
                    <li>
                        <i class="bi bi-archive" aria-hidden="true"></i>
                        <span><strong>احتفظ بالأصل:</strong> لا تقم بحذف الرسائل أو الحسابات الأصلية من جهازك قبل توثيقها بلقطات شاشة واضحة.</span>
                    </li>
                    <li>
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                        <span><strong>استكمل في أي وقت:</strong> يمكنك التوقف والعودة لاحقاً إلى قسم «المحادثات المحفوظة» لاستكمال تفاصيلك دون فقدان أي رسالة.</span>
                    </li>
                </ul>
            </aside>

            <div class="guidance-accordions">
                <details class="wathiq-faq" open>
                    <summary>
                        <div class="faq-summary-right">
                            <span class="faq-num">01</span>
                            <span class="faq-question">كيف تحمي منصة «وَثيق» هويتي الشخصية أثناء متابعة القضية؟</span>
                        </div>
                        <i class="bi bi-chevron-down faq-arrow" aria-hidden="true"></i>
                    </summary>
                    <div class="faq-answer">
                        صُممت المنصة بسياسة عزل صارمة للهوية؛ حيث يظهر البلاغ للمحقق المختص برقم مرجعي فقط دون اسمك أو بريدك الإلكتروني، ولا تُكشف بيانات هويتك إلا إذا منحت موافقة صريحة من داخل صفحة القضية. كما لا تتيح صلاحيات مدير النظام قراءة محتوى الشكاوى أو فتح مرفقاتها.
                    </div>
                </details>

                <details class="wathiq-faq">
                    <summary>
                        <div class="faq-summary-right">
                            <span class="faq-num">02</span>
                            <span class="faq-question">هل مجرّد كتابة الرسائل في المحادثة يُعد بلاغاً رسمياً؟</span>
                        </div>
                        <i class="bi bi-chevron-down faq-arrow" aria-hidden="true"></i>
                    </summary>
                    <div class="faq-answer">
                        لا؛ كتابة الرسائل وحفظ المحادثة يبقيها خاصة بك داخل حسابك لتتمكن من ترتيب أفكارك واستكمال الوقائع. لا يتم إنشاء قضية رسمية أو إحالتها لطابور المحققين إلا بعد صدور التقييم وموافقتك الصريحة على خيار تقديم البلاغ.
                    </div>
                </details>

                <details class="wathiq-faq">
                    <summary>
                        <div class="faq-summary-right">
                            <span class="faq-num">03</span>
                            <span class="faq-question">كيف أتحكم بمن يطّلع على الصور والمستندات المرفقة؟</span>
                        </div>
                        <i class="bi bi-chevron-down faq-arrow" aria-hidden="true"></i>
                    </summary>
                    <div class="faq-answer">
                        عند رفع أي دليل رقمي بصيغة (PDF, PNG, JPG)، يمكنك تحديده كمرفق مقيّد، ولن يتمكن حتى المحقق المستلم للقضية من استعراضه إلا بعد منحك إذن الإفصاح الخاص به. وفي حال تعديل الدليل، يُحفظ الإصدار الجديد مع سبب التعديل وتبقى النسخة الأصلية محفوظة لضمان سلامة الإجراءات.
                    </div>
                </details>

                <details class="wathiq-faq">
                    <summary>
                        <div class="faq-summary-right">
                            <span class="faq-num">04</span>
                            <span class="faq-question">كيف أتابع الردود والتغييرات التي تطرأ على حالة بلاغي؟</span>
                        </div>
                        <i class="bi bi-chevron-down faq-arrow" aria-hidden="true"></i>
                    </summary>
                    <div class="faq-answer">
                        من خلال صفحة «طلباتي وبلاغاتي» وقسم «الإشعارات»؛ حيث يصلك تنبيه فوري عند استلام البلاغ من محقق مختص، أو عند إرسال استفسار رسمي لك، أو عند تحديث حالة البلاغ (قيد المراجعة، قيد المعالجة، تم الحل، أو مغلق).
                    </div>
                </details>
            </div>
        </div>
    </section>
</div>