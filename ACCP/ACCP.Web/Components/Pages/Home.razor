@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>الرئيسية | وَثيق | WATHIQ</PageTitle>

<div class="wathiq-home" dir="rtl">
    <section class="wathiq-hero" aria-labelledby="hero-title">
        <span class="wathiq-eyebrow">وَثيق | WATHIQ</span>
        <h1 id="hero-title">توثيق البلاغات السيبرانية ومتابعتها</h1>
        <p class="wathiq-hero-lead">منصة لتسجيل تفاصيل الواقعة ومتابعة الطلبات من مساحة الحساب.</p>

        <div class="wathiq-hero-actions">
            <AuthorizeView Context="auth">
                <Authorized>
                    @if (auth.User.IsInRole("ADMIN"))
                    {
                        <a href="/admin/employees" class="wathiq-button wathiq-button-primary">لوحة الإدارة</a>
                        <a href="/admin/audit-logs" class="wathiq-button wathiq-button-secondary">سجل التدقيق</a>
                    }
                    else if (auth.User.IsInRole("OFFICER"))
                    {
                        <a href="/officer/dashboard" class="wathiq-button wathiq-button-primary">لوحة القضايا</a>
                        <a href="/notifications" class="wathiq-button wathiq-button-secondary">الإشعارات</a>
                    }
                    else
                    {
                        <a href="/cases/new" class="wathiq-button wathiq-button-primary">تقديم بلاغ</a>
                        <a href="/cases" class="wathiq-button wathiq-button-secondary">متابعة الطلبات</a>
                    }
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="wathiq-button wathiq-button-primary">تسجيل الدخول</a>
                    <a href="/register" class="wathiq-button wathiq-button-secondary">إنشاء حساب</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>

    <section class="wathiq-steps-section" aria-labelledby="steps-title">
        <div class="wathiq-section-heading">
            <span class="wathiq-section-kicker">خطوات الخدمة</span>
            <h2 id="steps-title">من التوثيق إلى المتابعة</h2>
        </div>

        <ol class="wathiq-steps">
            <li>
                <span class="wathiq-step-number">١</span>
                <div><h3>وثّق الواقعة</h3><p>سجّل التفاصيل الأساسية للطلب.</p></div>
            </li>
            <li>
                <span class="wathiq-step-number">٢</span>
                <div><h3>أرفق المعلومات</h3><p>أضف الملفات ذات الصلة عند الحاجة.</p></div>
            </li>
            <li>
                <span class="wathiq-step-number">٣</span>
                <div><h3>تابع الطلب</h3><p>راجع الحالة والتحديثات من حسابك.</p></div>
            </li>
        </ol>
    </section>
</div>
